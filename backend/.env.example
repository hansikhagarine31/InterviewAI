# Backend environment (copy to backend/.env). Never commit the real file.

# Required
GEMINI_API_KEY=
SECRET_KEY=            # python -c "import secrets; print(secrets.token_hex(32))"

# Production
ALLOWED_ORIGINS=http://localhost:5173
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google sign-in (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Password-reset emails (Brevo)
BREVO_API_KEY=
MAIL_SENDER=

FLASK_DEBUG=false
